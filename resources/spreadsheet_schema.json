{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GrepSpreadsheet",
  "type": "object",
  "required": ["title", "columns", "rows"],
  "properties": {
    "title": { "type": "string" },
    "description": { "type": "string" },
    "columns": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["key", "label"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "label": { "type": "string" },
          "type": { "type": "string", "enum": ["string", "number", "currency", "percent", "date", "url", "boolean"], "default": "string" },
          "unit": { "type": "string" }
        }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["values"],
        "properties": {
          "values": { "type": "object", "additionalProperties": true },
          "citations": { "type": "array", "items": { "type": "string", "format": "uri" } }
        }
      }
    },
    "footer_notes": { "type": "string" }
  }
}
